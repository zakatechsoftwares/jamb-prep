# Matches the credentials in docker-compose.yml's db service.
DATABASE_URL=postgres://jamb:jamb@localhost:5432/jamb_prep

# Signs and verifies reviewer session bearer tokens (apps/api/src/reviewer-identity.ts).
# Generate a real value for any non-local environment, e.g.: openssl rand -hex 32
REVIEWER_SESSION_SECRET=dev-only-secret-change-me

# tools/item-gen (session 10, OpenAI/Voyage by API key through session 12;
# moved to subscription CLIs in the local-first-pipeline session). No API
# key needed to run `pnpm item-gen` -- authoring runs through `codex exec`
# (sign in once with `codex login`, choosing "Sign in with ChatGPT") and the
# independent solve runs through `claude -p` (already signed in if you're
# running this from inside Claude Code itself). Embeddings run locally via
# @huggingface/transformers, no network call at all once the model's cached.
# Optional overrides -- tools/item-gen/src/cli.ts's own defaults apply if unset.
# CODEX_MODEL=
# CLAUDE_MODEL=
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# ITEM_GEN_LOG_DIR=generated-items-raw

# tools/sync-to-production: one-way push of local Postgres's already-approved
# items to a production database (Railway/Supabase). SOURCE_DATABASE_URL
# defaults to DATABASE_URL above, but DATABASE_URL must still be set too --
# @jamb/db's own index checks it eagerly at import time, before this tool's
# code ever runs (see tools/sync-to-production/src/cli.ts's own comment).
# SOURCE_DATABASE_URL=
TARGET_DATABASE_URL=
# Set to 'true' when TARGET_DATABASE_URL points at a hosted Postgres that
# requires SSL (Supabase and similar) -- same convention as PGSSL above.
TARGET_PGSSL=
