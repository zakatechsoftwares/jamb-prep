# Matches the credentials in docker-compose.yml's db service.
DATABASE_URL=postgres://jamb:jamb@localhost:5432/jamb_prep

# Signs and verifies reviewer session bearer tokens (apps/api/src/reviewer-identity.ts).
# Generate a real value for any non-local environment, e.g.: openssl rand -hex 32
REVIEWER_SESSION_SECRET=dev-only-secret-change-me

# tools/item-gen (session 10) — a Console API key, not an OAuth session key.
# Required to run `pnpm item-gen`; unused by every other package.
ANTHROPIC_API_KEY=
# Anthropic has no embeddings endpoint; Voyage is Anthropic's own
# recommended embeddings partner, used for tools/item-gen's duplicate
# detection (item-generation-spec.md §3.3).
VOYAGE_API_KEY=
# Optional overrides — tools/item-gen/src/cli.ts's own defaults apply if unset.
# ANTHROPIC_MODEL=claude-sonnet-5
# VOYAGE_MODEL=voyage-3
# ITEM_GEN_LOG_DIR=generated-items-raw
