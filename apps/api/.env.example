# What this process actually needs at runtime. In local dev these are
# loaded from packages/db/.env instead (via `node --env-file=...`); a real
# deployment sets these directly on the hosting platform.

# A hosted Postgres connection string (Supabase and similar). Local Postgres
# via docker-compose doesn't need PGSSL at all.
DATABASE_URL=
# Set to 'true' only when DATABASE_URL points at a hosted Postgres that
# requires SSL (see packages/db/src/client.ts) -- local Postgres has no SSL
# listener and must leave this unset.
PGSSL=

# Signs and verifies reviewer session bearer tokens (src/reviewer-identity.ts).
# Generate a real value for any non-local environment: openssl rand -hex 32
REVIEWER_SESSION_SECRET=dev-only-secret-change-me

# Signs and verifies candidate session bearer tokens (src/candidate-identity.ts).
# Deliberately a separate secret from REVIEWER_SESSION_SECRET -- a candidate
# is a structurally different actor from a reviewer. Generate a real value
# for any non-local environment: openssl rand -hex 32
CANDIDATE_SESSION_SECRET=dev-only-candidate-secret-change-me

# Optional. Most hosting platforms (Railway included) inject this
# automatically -- index.ts already falls back to 3000 if unset.
# PORT=3000

# Optional. Defaults to 10 -- see packages/db/src/client.ts's own comment on
# why this needs to be liftable without a code change.
# PGPOOL_MAX=10
